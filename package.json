{
  "name": "timeline",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">= 22.12.0",
    "bun": ">= 1.4.2"
  },
  "scripts": {
    "dev": "bun run --parallel --filter @timeline/client --filter @timeline/server dev",
    "dev:client": "bun run --filter @timeline/client dev",
    "dev:server": "bun run --filter @timeline/server dev",
    "build:client": "bun run --filter @timeline/client build",
    "start:client": "bun run --filter @timeline/client start",
    "start:server": "bun run --filter @timeline/server start",
    "lint": "eslint client server packages/contracts scripts",
    "lint:client": "eslint client",
    "lint:client:fix": "eslint client --fix",
    "lint:server": "eslint server packages/contracts",
    "lint:server:fix": "eslint server packages/contracts --fix",
    "lint:contracts": "eslint packages/contracts",
    "lint:contracts:fix": "eslint packages/contracts --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "client/**/*.{js,jsx,mjs,ts,tsx}": "eslint --fix",
    "{server,packages/contracts,scripts}/**/*.{ts,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "ffmpeg-static",
    "sharp",
    "@tailwindcss/oxide",
    "unrs-resolver",
    "@parcel/watcher",
    "esbuild"
  ]
}