{
  "name": "timeline",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">= 22.12.0",
    "bun": ">= 1.4.2"
  },
  "scripts": {
    "dev:client": "cd client && next dev",
    "build:client": "cd client && next build",
    "start:client": "cd client && bunx serve@latest out",
    "lint:client": "eslint client",
    "lint:client:fix": "eslint client --fix",
    "typegen:client": "cd client && next typegen",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "dev:server": "NODE_ENV=development bun --watch run server/src/index.ts",
    "start:server": "NODE_ENV=production bun run server/src/index.ts",
    "lint:server": "eslint server configs enums interfaces",
    "lint:server:fix": "eslint server configs enums interfaces --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "client/**/*.{js,jsx,mjs,ts,tsx}": "eslint --fix",
    "{server,configs,enums,interfaces}/**/*.ts": "eslint --fix"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@fancyapps/ui": "^6.1.15",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "elysia": "^1.4.30",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "github-markdown-css": "^5.9.0",
    "html-react-parser": "^6.1.8",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.1.0",
    "marked-alert": "^2.1.2",
    "md5": "^2.3.0",
    "next": "16.3.8",
    "node-schedule": "^2.1.1",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-transition-group": "^4.4.5",
    "reflect-metadata": "^0.2.2",
    "swr": "^2.5.1",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "video.js": "^8.24.1",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "^1.4.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.1",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}
